rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function verifiedGoogleAccount() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function coordinatesValid(data) {
      return (!('latitude' in data) && !('longitude' in data)) ||
        (('latitude' in data) && ('longitude' in data) &&
          data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
          data.longitude is number && data.longitude >= -180 && data.longitude <= 180);
    }

    function coordinateEvidenceValid(data) {
      return !('coordinatesVerified' in data) || data.coordinatesVerified != true ||
        ('coordinateSourceUrl' in data && data.coordinateSourceUrl is string &&
          data.coordinateSourceUrl.matches('https://.+'));
    }

    function visiblePlaceExists(placeId) {
      return exists(/databases/$(database)/documents/places/$(placeId)) &&
        get(/databases/$(database)/documents/places/$(placeId)).data.status == 'ACTIVE';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && verifiedGoogleAccount()
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      allow delete: if isAdmin();

      match /favorites/{placeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/places/$(placeId));
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /places/{placeId} {
      // Public catalog data is limited to published places. Owners and admins can inspect drafts.
      allow get, list: if isAdmin() || resource.data.status == 'ACTIVE' ||
        (signedIn() && resource.data.merchantId == request.auth.uid);

      allow create: if isAdmin()
        ? coordinatesValid(request.resource.data) && coordinateEvidenceValid(request.resource.data)
        : verifiedGoogleAccount()
          && request.resource.data.keys().hasAll(['id', 'name', 'type', 'merchantId', 'status', 'featured', 'verified', 'isSponsored', 'rating', 'reviewCount', 'createdAt'])
          && request.resource.data.keys().hasOnly(['name', 'category', 'categoryLabel', 'type', 'description', 'shortDescription', 'imageUrl', 'gallery', 'address', 'hours', 'phone', 'whatsapp', 'instagram', 'website', 'featured', 'verified', 'badgeText', 'rating', 'reviewCount', 'status', 'merchantId', 'merchantName', 'createdAt', 'isSponsored', 'id'])
          && request.resource.data.id == placeId
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.type == 'business'
          && request.resource.data.merchantId == request.auth.uid
          && request.resource.data.status == 'PENDING_PAYMENT'
          && request.resource.data.verified == false
          && request.resource.data.featured == false
          && request.resource.data.isSponsored == false
          && request.resource.data.rating == 0
          && request.resource.data.reviewCount == 0
          && request.resource.data.createdAt == request.time;

      allow update: if isAdmin() && coordinatesValid(request.resource.data) && coordinateEvidenceValid(request.resource.data)
        || (signedIn() && resource.data.merchantId == request.auth.uid && resource.data.status != 'BLOCKED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'shortDescription', 'imageUrl', 'gallery', 'address', 'hours', 'phone', 'whatsapp', 'instagram', 'website'])
          && coordinatesValid(request.resource.data));
      allow delete: if isAdmin();
    }

    match /routes/{routeId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /guides/{guideId} {
      allow get, list: if isAdmin() || resource.data.status == 'ACTIVE' ||
        (signedIn() && resource.data.merchantUserId == request.auth.uid);
      allow create: if isAdmin() || (verifiedGoogleAccount()
        && request.resource.data.merchantUserId == request.auth.uid
        && request.resource.data.status == 'PENDING_PAYMENT'
        && request.resource.data.verified == false
        && request.resource.data.monthlySubscriptionPrice == 49.9
        && request.resource.data.rating == 0
        && request.resource.data.reviewsCount == 0
        && (!('featured' in request.resource.data) || request.resource.data.featured == false)
        && request.resource.data.id == guideId
        && request.resource.data.keys().hasOnly(['id', 'name', 'cadastur', 'photoUrl', 'specialty', 'specialtyLabel', 'bio', 'experienceYears', 'languages', 'phone', 'whatsapp', 'email', 'rating', 'reviewsCount', 'pricePerPerson', 'duration', 'groupPrice', 'includedItems', 'itineraryHighlights', 'meetingPoint', 'availability', 'verified', 'featured', 'status', 'monthlySubscriptionPrice', 'merchantUserId']));
      allow update: if isAdmin() || (signedIn() && resource.data.merchantUserId == request.auth.uid
        && resource.data.status != 'BLOCKED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl', 'bio', 'phone', 'whatsapp', 'email', 'pricePerPerson', 'duration', 'includedItems', 'itineraryHighlights', 'meetingPoint', 'availability', 'languages', 'specialty', 'specialtyLabel', 'experienceYears']));
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow get, list: if isAdmin() || resource.data.hidden == false ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if verifiedGoogleAccount()
        && request.resource.data.keys().hasAll(['placeId', 'userId', 'userName', 'rating', 'comment', 'createdAt', 'hidden'])
        && request.resource.data.keys().hasOnly(['placeId', 'userId', 'userName', 'rating', 'comment', 'createdAt', 'hidden'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.placeId is string && visiblePlaceExists(request.resource.data.placeId)
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 2000
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.hidden == false;
      allow update: if isAdmin() || (isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'userName'])
        && request.resource.data.placeId == resource.data.placeId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.hidden == resource.data.hidden
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 2000
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 80);
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /reports/{reportId} {
      allow get, list: if isAdmin() || isOwner(resource.data.userId);
      allow create: if verifiedGoogleAccount()
        && request.resource.data.keys().hasAll(['placeId', 'placeName', 'reason', 'reasonLabel', 'details', 'createdAt', 'resolved', 'userId', 'id'])
        && request.resource.data.keys().hasOnly(['placeId', 'placeName', 'reason', 'reasonLabel', 'details', 'userContact', 'createdAt', 'resolved', 'userId', 'id'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == reportId
        && request.resource.data.placeId is string && visiblePlaceExists(request.resource.data.placeId)
        && request.resource.data.resolved == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.details is string && request.resource.data.details.size() <= 2000
        && request.resource.data.placeName is string && request.resource.data.placeName.size() <= 120
        && request.resource.data.reasonLabel is string && request.resource.data.reasonLabel.size() <= 120
        && (!('userContact' in request.resource.data) || (request.resource.data.userContact is string && request.resource.data.userContact.size() <= 200))
        && request.resource.data.reason in ['endereco_errado', 'negocio_inexistente', 'informacao_incorreta', 'conteudo_inadequado', 'outro'];
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isAdmin() || settingId == 'public';
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        (settingId != 'public' || !('commercialPrice' in request.resource.data) || request.resource.data.commercialPrice == 49.9);
      allow delete: if isAdmin();
    }

    // Payment state may only be written by a future trusted gateway/webhook integration.
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.merchantId == request.auth.uid);
      allow write: if false;
    }
  }
}
