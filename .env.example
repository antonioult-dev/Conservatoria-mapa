# Vercel provides NODE_ENV and its Function listener. PORT is for local/other hosts only.
NODE_ENV=production
PORT=3000

# Firebase Web app settings (public identifiers, embedded in the client build).
# The checked-in applet config is used as a fallback; set these to override it per environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Optional. Leave empty to use the database ID from firebase-applet-config.json.
VITE_FIRESTORE_DATABASE_ID=

# Firebase Admin SDK: backend-only secret used to set administrator custom claims.
# Store compact JSON in the hosting provider's secret manager; never use a VITE_ prefix.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated, verified Google account emails explicitly authorized as administrators.
ADMIN_EMAILS=

# Optional. If absent, the AI endpoint returns a clear 503 and the rest of the app remains available.
GEMINI_API_KEY=

# Public support destination used by the Gmail contact flow and privacy contact text.
VITE_SUPPORT_EMAIL=

# Optional HTTPS OSRM-compatible routing endpoint. No route is drawn until a real provider is configured.
VITE_ROUTING_API_URL=

# Optional: exact number of trusted reverse proxies in front of Express (for example 1).
# Keep unset unless the hosting topology is known; never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=
